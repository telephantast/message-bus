{
    "name": "thesis/message-bus",
    "description": "Thesis Message Bus",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/log": "^3.0",
        "thesis/exceptionally": "^0.3.0",
        "thesis/time-span": "^0.2.3",
        "thesis/transaction": "^0.1.1"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "amphp/postgres": "^2.2",
        "symfony/var-dumper": "^8.0.6",
        "testo/testo": "^0.10.2",
        "thesis/amqp": "^1.0",
        "thesis/pgmq": "^0.1.5",
        "thesis/sync-once": "^0.1.3"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
